// Prisma schema — TicketFiscal AI
// Arquitectura multi-tenant: 1 Gestoría → N Empresas → N justificantes.
// Usuarios con rol GESTOR (pertenecen a una gestoría) o CLIENTE (pertenecen a una empresa).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Gestoria {
  id        String    @id @default(cuid())
  nombre    String
  cif       String?
  ciudad    String?
  createdAt DateTime  @default(now())
  usuarios  Usuario[]
  empresas  Empresa[]
}

model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nombre       String
  rol          String // GESTOR | CLIENTE
  gestoriaId   String?
  gestoria     Gestoria? @relation(fields: [gestoriaId], references: [id])
  empresaId    String?
  empresa      Empresa?  @relation(fields: [empresaId], references: [id])
  createdAt    DateTime  @default(now())
}

model Empresa {
  id         String      @id @default(cuid())
  nombre     String
  nif        String
  direccion  String?
  ciudad     String?
  whatsapp   String?
  gestoriaId String?
  gestoria   Gestoria?   @relation(fields: [gestoriaId], references: [id])
  usuarios   Usuario[]
  documentos Documento[]
  createdAt  DateTime    @default(now())
}

model Documento {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  // Resultado de la extracción IA
  estado        String // VALIDO | REQUIERE_REVISION | ILEGIBLE
  tipoDocumento String // FACTURA_COMPLETA | FACTURA_SIMPLIFICADA | NO_VALIDO
  ivaDeducible  Boolean  @default(false)
  emisorNombre  String?
  emisorNif     String?
  nifEmisorValido Boolean?
  receptorNombre String?
  receptorNif   String?
  nifReceptorValido Boolean?
  numeroFactura String?
  fechaEmision  String? // YYYY-MM-DD (fecha de devengo)
  moneda        String   @default("EUR")

  // Impuestos (primera línea del desglose)
  baseImponible Float    @default(0)
  porcentajeIva Float    @default(0)
  cuotaIva      Float    @default(0)
  irpfPorcentaje Float   @default(0)
  irpfImporte   Float    @default(0)
  totalFactura  Float    @default(0)

  cuentaPgc     String?
  confianza     Float    @default(0)
  motivoRevision String?
  mensajeWhatsapp String?

  // Metadatos
  imagenNombre  String?
  trimestre     String? // 1T2026 ... 4T2026 (por fecha de devengo)
  createdAt     DateTime @default(now())
}
