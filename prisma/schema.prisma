// Prisma schema — TicketFiscal AI
// Documentos fiscales extraídos de tickets/facturas vía WhatsApp

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Documento {
  id              String   @id @default(cuid())
  clienteNombre   String   @default("Juan Pérez García")
  clienteNif      String   @default("12345678Z")

  // Resultado de la extracción IA
  estado          String // VALIDO | REQUIERE_REVISION | ILEGIBLE
  tipoDocumento   String // FACTURA_COMPLETA | FACTURA_SIMPLIFICADA | NO_VALIDO
  ivaDeducible    Boolean  @default(false)
  emisorNombre    String?
  emisorNif       String?
  nifEmisorValido   Boolean? // validación determinística del dígito de control
  receptorNombre  String?
  receptorNif     String?
  nifReceptorValido Boolean?
  numeroFactura   String?
  fechaEmision    String? // YYYY-MM-DD
  moneda          String   @default("EUR")

  // Impuestos (primera línea del desglose)
  baseImponible   Float    @default(0)
  porcentajeIva   Float    @default(0)
  cuotaIva        Float    @default(0)
  irpfPorcentaje  Float    @default(0)
  irpfImporte     Float    @default(0)
  totalFactura    Float    @default(0)

  cuentaPgc       String?
  confianza       Float    @default(0)
  motivoRevision  String?
  mensajeWhatsapp String?

  // Metadatos del demo
  imagenNombre    String? // nombre del archivo de muestra o "subida propia"
  trimestre       String? // 1T2025 ... 4T2025
  createdAt       DateTime @default(now())
}
