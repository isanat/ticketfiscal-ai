// TicketFiscal AI — esquema de datos (PostgreSQL en Neon).
// Multi-tenant: 1 Gestoría → N Empresas → N Documentos.
// Dinero en Decimal(14,2): nunca Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión agrupada (pooler de Neon) para el runtime serverless.
  // Nombres de las variables que inyecta la integración Neon de Vercel (store STORAGE_*).
  url       = env("STORAGE_POSTGRES_PRISMA_URL")
  // Conexión directa, usada solo por `prisma migrate`.
  directUrl = env("STORAGE_POSTGRES_URL_NON_POOLING")
}

enum EstadoCuenta {
  ACTIVA
  SUSPENDIDA
}

enum EstadoGestoria {
  PENDIENTE
  ACTIVA
  SUSPENDIDA
}

enum Rol {
  GESTOR
  CLIENTE
  ADMIN
}

enum EstadoEmpresa {
  PENDIENTE
  APROBADA
  RECHAZADA
  SUSPENDIDA
}

enum EstadoDocumento {
  VALIDO
  REQUIERE_REVISION
  ILEGIBLE
}

enum TipoDocumento {
  FACTURA_COMPLETA
  FACTURA_SIMPLIFICADA
  NO_VALIDO
}

/// Decisión humana de la gestoría sobre el justificante.
enum RevisionDocumento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum OrigenDocumento {
  WEB
  WHATSAPP
}

model Gestoria {
  id               String         @id @default(cuid())
  nombre           String
  cif              String?
  ciudad           String?
  createdAt        DateTime       @default(now())
  usuarios         Usuario[]
  empresas         Empresa[]
  estado           EstadoGestoria @default(PENDIENTE)
  motivoSuspension String?
}

model Usuario {
  id               String                @id @default(cuid())
  email            String                @unique
  passwordHash     String
  nombre           String
  rol              Rol
  gestoriaId       String?
  gestoria         Gestoria?             @relation(fields: [gestoriaId], references: [id])
  empresaId        String?               @unique
  empresa          Empresa?              @relation(fields: [empresaId], references: [id])
  sesiones         Sesion[]
  auditoria        AuditoriaEvento[]
  createdAt        DateTime              @default(now())
  estado           EstadoCuenta          @default(ACTIVA)
  motivoSuspension String?
  suspendidoEn     DateTime?
  ultimoAcceso     DateTime?
  totp             TotpAdmin?
  codigosRespaldo  CodigoRespaldoAdmin[]
  codigosEmail     CodigoEmail[]
}

/// Sesión revocable. Se guarda el hash SHA-256 del token, nunca el token.
model Sesion {
  id               String    @id @default(cuid())
  usuarioId        String
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  expiraEn         DateTime
  revocadaEn       DateTime?
  createdAt        DateTime  @default(now())
  /// Última verificación TOTP (solo ADMIN). Los cambios sensibles exigen una reciente.
  totpVerificadoEn DateTime?
  /// Si es una sesión de soporte, id del administrador que la abrió.
  impersonadoPorId String?
  ip               String?
  userAgent        String?

  @@index([usuarioId])
}

model Empresa {
  id                      String                  @id @default(cuid())
  nombre                  String
  nif                     String                  @unique
  direccion               String?
  ciudad                  String?
  /// Número en formato E.164 sin "+" (p. ej. 34600111222). Identifica el canal WhatsApp.
  whatsapp                String?                 @unique
  estado                  EstadoEmpresa           @default(PENDIENTE)
  gestoriaId              String?
  gestoria                Gestoria?               @relation(fields: [gestoriaId], references: [id])
  usuarios                Usuario[]
  documentos              Documento[]
  createdAt               DateTime                @default(now())
  motivoSuspension        String?
  movimientos             MovimientoBancario[]
  solicitudes             SolicitudJustificante[]
  /// Último mensaje recibido por WhatsApp: abre la ventana de 24 h para responder con texto libre.
  ultimoMensajeWhatsappEn DateTime?

  @@index([gestoriaId, estado])
}

model Documento {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  // Resultado de la extracción y de las reglas deterministas
  estado            EstadoDocumento
  tipoDocumento     TipoDocumento
  ivaDeducible      Boolean         @default(false)
  emisorNombre      String?
  emisorNif         String?
  nifEmisorValido   Boolean?
  receptorNombre    String?
  receptorNif       String?
  nifReceptorValido Boolean?
  numeroFactura     String?
  fechaEmision      DateTime?       @db.Date
  moneda            String          @default("EUR")

  // Totales (suma de LineaImpuesto)
  baseImponible  Decimal         @db.Decimal(14, 2)
  porcentajeIva  Decimal         @db.Decimal(5, 2)
  cuotaIva       Decimal         @db.Decimal(14, 2)
  irpfPorcentaje Decimal         @db.Decimal(5, 2)
  irpfImporte    Decimal         @db.Decimal(14, 2)
  totalFactura   Decimal         @db.Decimal(14, 2)
  lineas         LineaImpuesto[]

  cuentaPgc       String?
  confianza       Float   @default(0)
  motivoRevision  String? @db.Text
  mensajeWhatsapp String? @db.Text

  // Evidencia y trazabilidad
  imagenNombre      String?
  imagenMime        String
  imagenBytes       Int
  /// SHA-256 del binario original: deduplicación e integridad.
  imagenHash        String
  origen            OrigenDocumento @default(WEB)
  /// Id del mensaje de WhatsApp (wamid): idempotencia del webhook.
  whatsappMensajeId String?         @unique
  trimestre         String? // 1T2026 … 4T2026 (fecha de devengo)

  // Revisión humana por la gestoría
  revision      RevisionDocumento @default(PENDIENTE)
  revisadoEn    DateTime?
  revisadoPorId String?

  // Borrado lógico: un registro fiscal no se destruye.
  eliminadoEn DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  conciliacion Conciliacion?

  // Deduplicación por hash en la aplicación (filtrando borrados lógicos).
  @@index([empresaId, imagenHash])
  @@index([empresaId, trimestre])
  @@index([empresaId, numeroFactura])
}

/// Desglose de IVA por tipo. Una factura puede tener varias líneas (10 % y 21 %).
model LineaImpuesto {
  id            String    @id @default(cuid())
  documentoId   String
  documento     Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  orden         Int
  baseImponible Decimal   @db.Decimal(14, 2)
  porcentajeIva Decimal   @db.Decimal(5, 2)
  cuotaIva      Decimal   @db.Decimal(14, 2)

  @@unique([documentoId, orden])
}

/// Contador para límites de uso (login, registro, extracción IA…). Compatible con serverless.
model LimiteUso {
  clave         String   @id
  contador      Int
  ventanaInicio DateTime
}

/// Registro de cambios sobre datos fiscales.
model AuditoriaEvento {
  id               String   @id @default(cuid())
  usuarioId        String?
  usuario          Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  gestoriaId       String?
  accion           String
  entidad          String
  entidadId        String
  detalle          Json?
  createdAt        DateTime @default(now())
  /// Administrador que actuaba en nombre del usuario (sesión de soporte).
  impersonadoPorId String?

  @@index([gestoriaId, createdAt])
  @@index([entidad, entidadId])
}

/// Segundo factor del administrador. El secreto se guarda cifrado (AES-256-GCM).
model TotpAdmin {
  id             String   @id @default(cuid())
  usuarioId      String   @unique
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  secretoCifrado String
  activado       Boolean  @default(false)
  /// Último intervalo de 30 s aceptado: impide reutilizar el mismo código.
  ultimoPaso     BigInt   @default(0)
  createdAt      DateTime @default(now())
}

/// Códigos de recuperación de un solo uso (se guarda su hash).
model CodigoRespaldoAdmin {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  hash      String
  usadoEn   DateTime?

  @@index([usuarioId])
}

/// Código de un solo uso enviado por e-mail (desactivado hasta tener dominio verificado).
model CodigoEmail {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proposito String
  hash      String
  intentos  Int       @default(0)
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId, proposito])
}

/// Ajustes no secretos editables desde la administración. Las claves de API viven en Vercel.
model Configuracion {
  clave          String   @id
  valor          Json
  actualizadoPor String?
  updatedAt      DateTime @updatedAt
}

/// Registro de cada extracción con IA: base del panel de uso y de costes.
model UsoVision {
  id        String   @id @default(cuid())
  empresaId String?
  proveedor String
  modelo    String?
  entrada   Int      @default(0)
  salida    Int      @default(0)
  ms        Int      @default(0)
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([empresaId, createdAt])
}

enum OrigenMovimiento {
  CSV
  N43
  /// Reservado: no se usa. Postgres no permite quitar valores de un enum sin recrearlo.
  OPEN_BANKING
}

enum EstadoConciliacion {
  CONFIRMADA
}

/// Movimiento del extracto bancario de una empresa (importado desde un extracto CSV o Norma 43).
model MovimientoBancario {
  id             String                 @id @default(cuid())
  empresaId      String
  empresa        Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Id estable del movimiento: reimportar el mismo extracto no duplica.
  idExterno      String
  fecha          DateTime               @db.Date
  /// Negativo = cargo (gasto), positivo = abono.
  importe        Decimal                @db.Decimal(14, 2)
  descripcion    String
  origen         OrigenMovimiento
  importadoPorId String?
  createdAt      DateTime               @default(now())
  conciliacion   Conciliacion?
  solicitud      SolicitudJustificante?

  @@unique([empresaId, idExterno])
  @@index([empresaId, fecha])
}

/// Vínculo confirmado entre un movimiento y un justificante.
model Conciliacion {
  id            String             @id @default(cuid())
  movimientoId  String             @unique
  movimiento    MovimientoBancario @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  documentoId   String             @unique
  documento     Documento          @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  puntuacion    Float
  estado        EstadoConciliacion @default(CONFIRMADA)
  motivos       Json
  decididoPorId String?
  createdAt     DateTime           @default(now())
}

enum EstadoSolicitud {
  PENDIENTE
  ENVIADA
  RESUELTA
  SIN_JUSTIFICANTE
  OMITIDA
  SIN_CANAL
}

/// Petición al cliente del justificante de un cargo bancario que no lo tiene.
model SolicitudJustificante {
  id            String             @id @default(cuid())
  empresaId     String
  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientoId  String             @unique
  movimiento    MovimientoBancario @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  estado        EstadoSolicitud    @default(PENDIENTE)
  envios        Int                @default(0)
  ultimoEnvioEn DateTime?
  /// «texto» (dentro de la ventana de 24 h) o «plantilla» (fuera de ella).
  via           String?
  creadaPorId   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([empresaId, estado])
}
