# TicketFiscal AI · SQLite local (opcional)
# Sin DATABASE_URL la app arranca en "modo memoria" con datos de demostración
# (útil en despliegues serverless como Vercel).
# La ruta es relativa a la carpeta prisma/.
DATABASE_URL="file:../db/custom.db"

# Motor de visión GLM en despliegues serverless (opcional).
# En desarrollo local el SDK z-ai-web-dev-sdk lee su propio .z-ai-config
# (cwd, home o /etc) y estas variables no hacen falta.
# ZAI_BASE_URL="https://..."
# ZAI_API_KEY="..."
# ZAI_TOKEN=""
# ZAI_CHAT_ID=""
# ZAI_USER_ID=""
# ZAI_MODEL="glm-5.3-flash"
