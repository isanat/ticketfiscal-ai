# ===== Base de datos (Neon PostgreSQL, región EU) =====
# STORAGE_POSTGRES_PRISMA_URL: cadena CON pooler (host ...-pooler...). La usa la app en runtime.
STORAGE_POSTGRES_PRISMA_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.eu-central-1.aws.neon.tech/ticketfiscal?sslmode=require&pgbouncer=true&connection_limit=1"
# STORAGE_POSTGRES_URL_NON_POOLING: cadena DIRECTA (sin -pooler). La usan las migraciones.
STORAGE_POSTGRES_URL_NON_POOLING="postgresql://USUARIO:CONTRASEÑA@ep-xxxx.eu-central-1.aws.neon.tech/ticketfiscal?sslmode=require"

# ===== Modos =====
# Demo con muestras conocidas si el motor IA falla. NUNCA activar en producción real.
DEMO_MODE="false"
# Siembra la cartera de demostración (solo local o entornos de demo).
SEED_DEMO="false"
# Imprescindible para sembrar en producción (no recomendado).
ALLOW_DEMO_IN_PRODUCTION="false"

# ===== Motor de visión (GLM / endpoint compatible) — obligatorio para extraer justificantes =====
ZAI_BASE_URL="https://..."
ZAI_API_KEY="..."
ZAI_MODEL="glm-5.3-flash"
# Opcionales según el proveedor:
# ZAI_TOKEN=""
# ZAI_CHAT_ID=""
# ZAI_USER_ID=""

# ===== WhatsApp Cloud API (Meta) — todas necesarias para activar el canal real =====
WHATSAPP_VERIFY_TOKEN="cadena-aleatoria-de-32-caracteres"
WHATSAPP_APP_SECRET="app-secret-de-la-app-de-meta"
WHATSAPP_ACCESS_TOKEN="token-permanente-del-system-user"
WHATSAPP_PHONE_NUMBER_ID="id-del-numero-de-whatsapp-business"
# WHATSAPP_API_VERSION="v21.0"

# ===== Límites de coste =====
# Justificantes que una empresa puede extraer con IA por día.
LIMITE_IA_DIARIO_EMPRESA="50"
